# ============================================================
#  MindCache — .gitignore
#  Keep this repo clean: no models, no data dumps, no caches.
# ============================================================

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Virtual environments
venv/
.venv/
env/
.env/

# Environment variable files
.env
.env.*

# Build / packaging artefacts
*.egg-info/
dist/
build/
*.egg
MANIFEST

# Type-checker / test caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.tox/
htmlcov/
.coverage
coverage.xml

# macOS metadata
.DS_Store
.AppleDouble
.LSOverride

# ── IDE / Editor ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── AI / ML Models (never commit large binary files!) ────────
*.gguf
*.bin
*.onnx
*.pt
*.pth
*.safetensors
.model_cache/
hf_cache/
models/

# ── Caches & generated indexes ───────────────────────────────
cache/
*.pkl

# ── Databases ────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm

# ── BEAM dataset files (large parquet + raw JSON dumps) ──────
BEAM/
# Exception: small helper scripts inside BEAM/ are OK to commit
# Use: git add -f BEAM/data.py  (or similar) to force-add them

# ── Scratch / dev workspace ───────────────────────────────────
scratch/

# ── Blog / writeup working files ──────────────────────────────
Blog Files/

# ── Evaluation result outputs ────────────────────────────────
# Raw JSON result files are large and reproducible; exclude them.
results/
eval/results/
*.results.json
*_results.json

# ── Config overrides (may contain secrets / local paths) ─────
config/

# ── Data exports ─────────────────────────────────────────────
*.parquet
*.wav
*.png
*.jpg
*.jpeg
*.gif

# ── Chat / memory exports ────────────────────────────────────
LLM_CHATS/

# ── Recovery / backup dirs ───────────────────────────────────
recovery_backups/
useless/

# ── MindCache internal runtime state ─────────────────────────
# These are auto-generated at runtime and should not be committed
mindcache/**/.root_orthogonality_state.json
.root_orthogonality_state.json

# ── Misc logs / temp files ───────────────────────────────────
*.log
*.tmp
*.bak
*.orig
ingest_stats.txt